# ---------------------------------------------------------------------------
# BuzzIn environment template. Copy to .env.local and fill in real values.
# Never commit .env.local. Placeholders only in this file.
# ---------------------------------------------------------------------------

# Public base URL of the deployment (used for QR codes and join links).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Auth + embedded wallets ------------------------------------------------
# Google OAuth 2.0 Web client ID (Google Cloud Console > Credentials).
# Leave blank to run with guest sign-in; everything else behaves identically.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Signs session cookies and derives each player's embedded wallet. REQUIRED in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SESSION_SECRET=

# --- Database + realtime (Supabase) ----------------------------------------
# Leave blank to run with the in-memory store (single-instance dev only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI Game Master ---------------------------------------------------------
# Optional. Without a key the deterministic local Game Master is used.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.6-flash
AI_API_KEY=

# --- Monad ------------------------------------------------------------------
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_MONAD_CHAIN_ID=10143
NEXT_PUBLIC_MONAD_EXPLORER_URL=https://testnet.monadvision.com
NEXT_PUBLIC_SETTLEMENT_CONTRACT_ADDRESS=

# Server-only signing key for the demo treasury. NEVER expose to the browser.
TREASURY_PRIVATE_KEY=

# --- Game economy / demo mode ----------------------------------------------
DEMO_MODE=true
DEMO_TOTAL_TREASURY=25
DEFAULT_PLAYER_ALLOCATION=1
DEFAULT_GAME_BALANCE=0.5
DEFAULT_PRIZE_POOL_ALLOCATION=0.5
WRONG_ANSWER_PENALTY=0.1
MAX_WRONG_ANSWERS=5
DEFAULT_ROOM_CAP=25

# Comma-separated emails granted the ADMIN role. Hosting does NOT require admin —
# room control is authorised by ownership. Admin is only the cross-room overview
# and the destructive demo tools.
ADMIN_EMAILS=

# Pins the primary admin (first ADMIN_EMAILS entry) to a wallet they already
# control, instead of a server-derived one. Defaults to the treasury address.
ADMIN_WALLET_ADDRESS=

# Operator token. Grants admin at /admin when running guest sign-in (no email to
# allowlist), and gates the demo-reset endpoint. Leave blank to disable both.
ADMIN_API_TOKEN=
